{
  "name": "@team-plain/typescript-sdk",
  "version": "5.12.1",
  "description": "Typescript SDK for Plain's Core GraphQL API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "build:docs": "typedoc --plugin typedoc-plugin-missing-exports src/index.ts",
    "codegen": "pnpm run codegen:graphql && pnpm run codegen:webhooks",
    "codegen:graphql": "graphql-codegen",
    "codegen:webhooks": "sh ./scripts/codegen-webhooks.sh",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "vitest",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.2",
    "@changesets/cli": "^2.26.1",
    "@graphql-codegen/add": "^4.0.1",
    "@graphql-codegen/cli": "^3.3.1",
    "@graphql-codegen/typed-document-node": "^4.0.1",
    "@graphql-codegen/typescript": "^3.0.4",
    "@graphql-codegen/typescript-document-nodes": "^3.0.4",
    "@graphql-codegen/typescript-operations": "^3.0.4",
    "@rollup/plugin-json": "^6.1.0",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "^22.7.2",
    "esbuild": "^0.25.0",
    "json-schema-to-typescript": "^13.1.2",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^5.3.0",
    "rollup-plugin-esbuild": "^5.0.0",
    "typedoc": "^0.25.12",
    "typedoc-plugin-missing-exports": "^2.2.0",
    "typescript": "^5.1.6",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^2.1.1",
    "graphql": "^16.6.0",
    "lodash.get": "^4.4.2",
    "zod": "3.22.4"
  },
  "pnpm": {
    "overrides": {
      "immutable": "3.8.3",
      "lodash": "4.18.1",
      "tmp": "0.2.7",
      "ws": "8.21.0",
      "@isaacs/brace-expansion": "5.0.1",
      "brace-expansion@1": "1.1.13",
      "brace-expansion@2": "2.0.3",
      "js-yaml@3": "3.14.2",
      "js-yaml@4": "4.1.1",
      "minimatch@3": "3.1.4",
      "minimatch@4": "4.2.5",
      "minimatch@9": "9.0.7",
      "minimatch@10": "10.2.3",
      "yaml@1": "1.10.3"
    }
  }
}